# Frontend Deal Scout mode.
# VITE_* variables are exposed to the browser bundle.
# Keep preview in local/browser development. Never put API secrets in VITE_* variables.
VITE_DEAL_SCOUT_EMAIL_MODE=preview
VITE_DEAL_SCOUT_EMAIL_ENDPOINT=http://127.0.0.1:8787/api/deal-scout/digest/send

# Server-side or cron-worker email settings.
# RESEND_API_KEY must NOT be prefixed with VITE_.
# Production sending requires a server-side runtime, cron worker, or job.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=Startup Deal OS <onboarding@resend.dev>
DEAL_SCOUT_EMAIL_RECIPIENT=
# Keep false for hosted use so the browser cannot choose arbitrary recipients.
DEAL_SCOUT_ALLOW_CLIENT_RECIPIENT=false
DEAL_SCOUT_RUN_TOKEN=

# Optional local server port for the standalone Deal Scout email endpoint.
DEAL_SCOUT_EMAIL_SERVER_PORT=8787
DEAL_SCOUT_EMAIL_SERVER_HOST=127.0.0.1

# Browser origins allowed to call the standalone email endpoint.
# Comma-separate multiple origins. Set this to your deployed frontend URL in production.
DEAL_SCOUT_ALLOWED_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Server-side automated Deal Scout digest sources.
# Use public, allowed URLs or source text you have permission to process.
DEAL_SCOUT_SOURCE_URLS=
DEAL_SCOUT_AUTOMATION_SOURCES_JSON=[]
DEAL_SCOUT_PREFERRED_THEMES=AI infrastructure,data centers,energy,fintech,automation
DEAL_SCOUT_MAX_MINIMUM_INVESTMENT=500
DEAL_SCOUT_MAX_RED_FLAGS=6
DEAL_SCOUT_REQUIRE_NON_ACCREDITED=true
DEAL_SCOUT_REQUIRE_REG_CF_OR_REG_A=true
