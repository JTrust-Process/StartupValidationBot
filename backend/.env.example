# Startup Intelligence backend. Keep this file as a template; never commit a populated .env.
# Fly attaches Postgres using postgres://; the app also accepts postgresql:// and jdbc:postgresql: URLs.
DATABASE_URL=jdbc:postgresql://localhost:5432/startup_validation_bot

# Exact browser origins only. Do not include hash routes such as /#/radar.
APP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Server-only worker credential for scheduled jobs and server-to-server administration.
# Browser administration uses a separate server-side session. Never copy this token into Vite or browser storage.
RADAR_RUN_TOKEN=
RADAR_APP_URL=http://localhost:5173/#/radar

# Single-user browser administration. Store only the PBKDF2 hash generated by RadarPasswordHashTool.
# Production browser requests must use the same-origin Vercel proxy; use the exact frontend origin without a path.
RADAR_ADMIN_PASSWORD_HASH=
RADAR_BROWSER_ORIGIN=http://localhost:5173
RADAR_AUTH_SESSION_HOURS=8
RADAR_AUTH_SECURE_COOKIE=false
RADAR_AUTH_SAME_SITE=Strict
RADAR_AUTH_MAX_LOGIN_ATTEMPTS=5
RADAR_AUTH_LOGIN_WINDOW_MINUTES=15
RADAR_AUTH_LOGIN_LOCKOUT_MINUTES=15

# Reliable discovery sources. Product Hunt uses its official GraphQL API.
PRODUCT_HUNT_TOKEN=
RADAR_RSS_URLS=
RADAR_DISCOVERY_MAX_PER_SOURCE=30
RADAR_PREFERRED_THEMES=AI infrastructure,developer tools,energy,fintech,automation
RADAR_JOB_LEASE_MINUTES=120

# Development/test only. Keep false in staging and production.
RADAR_DEMO_FIXTURE_ENABLED=false

# Server-side AI only. Never prefix GROQ_API_KEY with VITE_ or expose it to the browser.
# The app remains deterministic when disabled, unconfigured, rate limited, or unavailable.
RADAR_ENABLE_AI=false
AI_PROVIDER=groq
GROQ_API_KEY=
RADAR_AI_MODEL=openai/gpt-oss-20b
RADAR_DEEP_DIVE_MODEL=openai/gpt-oss-120b
RADAR_AI_MAX_ITEMS_PER_RUN=25
RADAR_AI_MAX_RETRIES=2
RADAR_AI_PROMPT_VERSION=radar-v2
RADAR_AI_SCHEMA_VERSION=radar-analysis-v1

# Existing authenticated Deal Scout/Resend service integration for the combined digest.
DEAL_SCOUT_RUN_URL=http://127.0.0.1:8787/api/deal-scout/digest/run
DEAL_SCOUT_RUN_TOKEN=
RADAR_EMAIL_SEND_URL=http://127.0.0.1:8787/api/deal-scout/digest/send
RADAR_EMAIL_TOKEN=

# Worker schedule, evaluated in the configured time zone.
RADAR_TIME_ZONE=America/New_York
RADAR_DISCOVERY_CRON=0 0 6 * * *
RADAR_WATCHLIST_CRON=0 30 6 * * *
RADAR_TRENDS_CRON=0 0 7 * * SUN
RADAR_DIGEST_CRON=0 0 8 * * MON
