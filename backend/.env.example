# Startup Intelligence backend. Keep this file as a template; never commit a populated .env.
# Fly attaches Postgres using postgres://; the app also accepts postgresql:// and jdbc:postgresql: URLs.
DATABASE_URL=jdbc:postgresql://localhost:5432/startup_validation_bot

# Exact browser origins only. Do not include hash routes such as /#/radar.
APP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Server-only worker credential for scheduled jobs and server-to-server administration.
# Browser administration uses a separate server-side session. Never copy this token into Vite or browser storage.
RADAR_RUN_TOKEN=
RADAR_APP_URL=http://localhost:5173/#/radar

# Single-user browser administration. Store only the PBKDF2 hash generated by RadarPasswordHashTool.
# Production browser requests must use the same-origin Vercel proxy; use the exact frontend origin without a path.
RADAR_ADMIN_PASSWORD_HASH=
RADAR_BROWSER_ORIGIN=http://localhost:5173
RADAR_AUTH_SESSION_HOURS=8
RADAR_AUTH_SECURE_COOKIE=false
RADAR_AUTH_SAME_SITE=Strict
RADAR_AUTH_MAX_LOGIN_ATTEMPTS=5
RADAR_AUTH_LOGIN_WINDOW_MINUTES=15
RADAR_AUTH_LOGIN_LOCKOUT_MINUTES=15
# Login throttling is stored in PostgreSQL so lockouts survive deploys and Fly machine auto-stop.
# The Vercel proxy supplies the client address; set false only if the backend is exposed without one.
RADAR_AUTH_TRUST_FORWARDED_FOR=true
RADAR_AUTH_ATTEMPT_RETENTION_HOURS=72

# Flyway owns the schema (V1-V14). Leave unset; override to "none" only if Hibernate validation
# reports a benign type mismatch on an existing database.
# JPA_DDL_AUTO=validate

# Reliable discovery sources. Product Hunt uses its official GraphQL API.
PRODUCT_HUNT_TOKEN=
RADAR_RSS_URLS=
# Hacker News Launch/Show posts via the official public HN Search API. No key required, no anti-bot
# controls, and the "Launch HN: Name (YC S26)" convention yields accelerator and batch reliably.
RADAR_ENABLE_HACKER_NEWS=true
RADAR_DISCOVERY_MAX_PER_SOURCE=30
RADAR_PREFERRED_THEMES=AI infrastructure,developer tools,energy,fintech,automation
RADAR_JOB_LEASE_MINUTES=120

# Official SEC EDGAR offering discovery. Required before the live worker job can contact SEC.
# Use a descriptive application name plus a monitored contact address; never put this in VITE_*.
SEC_EDGAR_USER_AGENT=StartupValidationBot/1.0 contact@example.com
SEC_EDGAR_REQUESTS_PER_SECOND=2
SEC_EDGAR_RECENT_LIMIT=40
# The current-quarter master index is about 22 MB; the server still hard-caps this at 50 MB.
SEC_EDGAR_INDEX_MAX_RESPONSE_BYTES=32000000
SEC_CF_BASELINE_START_YEAR=2025
SEC_CF_BASELINE_MAX_DATASETS=8
SEC_CF_BASELINE_REFRESH_DAYS=30

# Native live-offering intake runs at the start of autonomous diligence. All bounds are hard-capped
# at 25; platform detail requests remain host-allowlisted and at most one request per second.
NATIVE_OFFERING_INTAKE_MAX_PER_PLATFORM=25
NATIVE_OFFERING_INTAKE_MAX_DETAIL_PAGES_PER_PLATFORM=10
NATIVE_OFFERING_INTAKE_MAX_NEW_COMPANIES_PER_RUN=25

# Development/test only. Keep false in staging and production.
RADAR_DEMO_FIXTURE_ENABLED=false

# Server-side AI only. Never prefix provider keys with VITE_ or expose them to the browser.
# The app remains deterministic when disabled, unconfigured, rate limited, or unavailable.
RADAR_ENABLE_AI=false
RADAR_AI_PROVIDER=groq
GROQ_API_KEY=
RADAR_AI_MODEL=openai/gpt-oss-20b
RADAR_DEEP_DIVE_MODEL=openai/gpt-oss-120b
# Router is opt-in. Obtain model or benchmark alias IDs from the authenticated Router model catalog.
ROUTER_API_KEY=
ROUTER_BASE_URL=https://api.router.com/v1
RADAR_ROUTER_ROUTINE_MODEL=
RADAR_ROUTER_DEEP_DIVE_MODEL=
RADAR_AI_MAX_ITEMS_PER_RUN=25
RADAR_AI_MAX_RETRIES=2
# Spaces routine Groq attempts to stay below the production account's token-per-minute limit.
RADAR_AI_GROQ_MIN_REQUEST_INTERVAL_MS=12500
RADAR_AI_PROMPT_VERSION=radar-v2
RADAR_AI_SCHEMA_VERSION=radar-analysis-v2

# Optional authenticated Deal Scout/Resend integration. Leave both URLs unset for initial staging.
DEAL_SCOUT_RUN_URL=
DEAL_SCOUT_RUN_TOKEN=
RADAR_EMAIL_SEND_URL=
RADAR_EMAIL_TOKEN=

# Canonical V1.1 high-signal email delivery. All values are server-only; never use a VITE_ prefix.
# RESEND_FROM must be a sender/domain accepted by the Resend account.
EMAIL_PROVIDER=preview
RESEND_API_KEY=
RESEND_FROM=Startup Intelligence <onboarding@resend.dev>
STARTUP_INTELLIGENCE_EMAIL_RECIPIENT=
# Optional environment label, for example "[STAGING] ". Leave blank in production.
STARTUP_INTELLIGENCE_EMAIL_SUBJECT_PREFIX=

# Bounded public diligence collection. Broad platform crawling is intentionally disabled.
DILIGENCE_MAX_OFFERINGS_PER_RUN=25
DILIGENCE_PLATFORM_MAX_RESPONSE_BYTES=2000000
DILIGENCE_PLATFORM_REQUESTS_PER_SECOND=1
CAMPAIGN_DISCOVERY_MAX_COMPANIES_PER_RUN=25
CAMPAIGN_DISCOVERY_MAX_CANDIDATES_PER_PLATFORM=5
CAMPAIGN_DISCOVERY_MAX_REQUESTS_PER_PLATFORM_PER_RUN=8
CAMPAIGN_DISCOVERY_SUCCESS_CACHE_HOURS=24
CAMPAIGN_DISCOVERY_NEGATIVE_CACHE_HOURS=72
CAMPAIGN_DISCOVERY_ERROR_CACHE_MINUTES=120

# Worker schedule, evaluated in the configured time zone.
RADAR_TIME_ZONE=America/New_York
RADAR_DISCOVERY_CRON=0 0 6 * * *
RADAR_WATCHLIST_CRON=0 30 6 * * *
RADAR_TRENDS_CRON=0 0 7 * * SUN
RADAR_DIGEST_CRON=0 0 8 * * MON
OFFERING_DISCOVERY_CRON=0 15 7 * * *
AUTONOMOUS_DILIGENCE_CRON=0 45 7 * * *
