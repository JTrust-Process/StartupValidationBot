# Frontend Deal Scout mode.
# VITE_* variables are exposed to the browser bundle.
# Keep preview in local/browser development. Never put API secrets in VITE_* variables.
VITE_DEAL_SCOUT_EMAIL_MODE=preview
VITE_DEAL_SCOUT_EMAIL_ENDPOINT=http://127.0.0.1:8787/api/deal-scout/digest/send

# Server-side or cron-worker email settings.
# RESEND_API_KEY must NOT be prefixed with VITE_.
# Production sending requires a server-side runtime, cron worker, or job.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=Startup Deal OS <onboarding@resend.dev>
DEAL_SCOUT_EMAIL_RECIPIENT=

# Optional local server port for the standalone Deal Scout email endpoint.
DEAL_SCOUT_EMAIL_SERVER_PORT=8787
